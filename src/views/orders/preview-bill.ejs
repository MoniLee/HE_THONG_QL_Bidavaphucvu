<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hóa Đơn Tạm Tính — Order #<%= bill.orderId %> | Quản Lý Quán Bi-Da</title>
</head>
<body>
  <nav>
    <strong>🎱 Quản Lý Quán Bi-Da</strong> &nbsp;|&nbsp;
    <a href="/">Trang chủ</a> |
    <a href="/tables">Bàn bi-da</a> |
    <a href="/menu">Thực đơn</a> |
    <a href="/orders">Order</a> |
    <a href="/invoices">Hóa đơn</a> |
    <a href="/shifts">Ca làm</a> |
    <a href="/revenue">Doanh thu</a>
  </nav>
  <%- include('../partials/auth-controls') %>
  <hr />

  <h1>Hóa Đơn Tạm Tính — Order #<%= bill.orderId %></h1>
  <p><em>(Chưa thanh toán — tính đến <%= new Date(bill.currentTime).toLocaleString('vi-VN') %>)</em></p>

  <table border="1" cellpadding="6" cellspacing="0">
    <tr><th>Bàn</th><td><%= bill.tableName %></td></tr>
    <tr><th>Bắt đầu</th><td><%= new Date(bill.startTime).toLocaleString('vi-VN') %></td></tr>
    <tr><th>Thời gian chơi</th><td><%= Number(bill.durationHours).toFixed(4) %> giờ</td></tr>
    <tr><th>Giá/giờ</th><td><%= Number(bill.pricePerHour).toLocaleString('vi-VN') %> đ</td></tr>
    <tr><th>Tiền bàn</th><td><%= Number(bill.tableAmount).toLocaleString('vi-VN') %> đ</td></tr>
    <tr><th>Tiền món</th><td><%= Number(bill.itemsAmount).toLocaleString('vi-VN') %> đ</td></tr>
    <tr><th>Tổng tạm tính</th><td><strong><%= Number(bill.totalAmount).toLocaleString('vi-VN') %> đ</strong></td></tr>
  </table>

  <% if (bill.items && bill.items.length > 0) { %>
    <h3>Danh sách món</h3>
    <table border="1" cellpadding="6" cellspacing="0">
      <thead>
        <tr><th>Tên món</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr>
      </thead>
      <tbody>
        <% bill.items.forEach(function(item) { %>
          <tr>
            <td><%= item.name %></td>
            <td><%= item.quantity %></td>
            <td><%= Number(item.unitPrice).toLocaleString('vi-VN') %> đ</td>
            <td><%= Number(item.subtotal).toLocaleString('vi-VN') %> đ</td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <br />
  <form method="POST" action="/orders/<%= bill.orderId %>/close" style="display:inline">
    <button type="submit" onclick="return confirm('Kết thúc phiên chơi và lập hóa đơn?')">Kết thúc &amp; Thanh toán</button>
  </form>
  &nbsp;
  <a href="/orders/<%= bill.orderId %>">← Quay lại order</a>

  <hr />
  <footer><small>Nhóm 14 &mdash; Quản Lý Quán Bi-Da &amp; Dịch Vụ &mdash; Đại Học Đông Á</small></footer>
</body>
</html>
